# Hoist all packages to node_modules root so NX, Next.js, and Storybook
# can find binaries and peer deps without needing to configure each one.
shamefully-hoist=true

# Don't fail on unresolved peer deps (NX and Storybook have known peer
# dependency mismatches on React 19 / Next.js 16 that don't affect runtime).
strict-peer-dependencies=false
auto-install-peers=true
